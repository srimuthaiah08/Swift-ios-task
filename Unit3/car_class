class Car {
    var brand: String
    var speed: Int
    init(brand: String, speed: Int = 0) { self.brand = brand; self.speed = speed }
    func accelerate() { speed += 10; print("\(brand) accelerated to \(speed) km/h") }
    func brake() { speed = max(0, speed - 10); print("\(brand) slowed to \(speed) km/h") }
}
let car = Car(brand: "Swift Motors")
car.accelerate()
car.accelerate()
car.brake()
