class Employee {
    var name: String
    var salary: Double {
        didSet {
            if salary != oldValue { print("\(name)'s salary changed from \(oldValue) to \(salary)") }
        }
    }
    init(name: String, salary: Double) { self.name = name; self.salary = salary }
}
let employee = Employee(name: "Arun", salary: 30000)
employee.salary = 35000
employee.salary = 40000
