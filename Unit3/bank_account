struct BankAccount {
    var balance: Double
    mutating func deposit(_ amount: Double) {
        guard amount > 0 else { print("Deposit amount must be positive."); return }
        balance += amount
        print("Deposited: \(amount). Balance: \(balance)")
    }
    mutating func withdraw(_ amount: Double) {
        guard amount > 0 else { print("Withdrawal amount must be positive."); return }
        guard amount <= balance else { print("Withdrawal denied: insufficient balance."); return }
        balance -= amount
        print("Withdrawn: \(amount). Balance: \(balance)")
    }
}
var account = BankAccount(balance: 500)
account.deposit(150)
account.withdraw(200)
account.withdraw(1000)
