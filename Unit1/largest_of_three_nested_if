import Foundation

let firstNumber = 25
let secondNumber = 40
let thirdNumber = 15

if firstNumber >= secondNumber {
    if firstNumber >= thirdNumber {
        print("Largest number: \(firstNumber)")
    } else {
        print("Largest number: \(thirdNumber)")
    }
} else {
    if secondNumber >= thirdNumber {
        print("Largest number: \(secondNumber)")
    } else {
        print("Largest number: \(thirdNumber)")
    }
}
