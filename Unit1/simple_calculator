import Foundation

let firstNumber = 20.0
let secondNumber = 5.0
let operation = "/"

switch operation {
case "+":
    print("Result: \(firstNumber + secondNumber)")
case "-":
    print("Result: \(firstNumber - secondNumber)")
case "*":
    print("Result: \(firstNumber * secondNumber)")
case "/":
    if secondNumber == 0 {
        print("Error: Division by zero is not allowed")
    } else {
        print("Result: \(firstNumber / secondNumber)")
    }
default:
    print("Invalid operator")
}
